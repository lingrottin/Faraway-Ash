---
import {
  ChevronLeft,
  ChevronRight,
  ChevronsLeft,
  ChevronsRight,
} from "@lucide/astro";

interface Props {
  page: number;
  totalPages: number;
  basePath: string; // e.g. "/" or "/categories/lie-yan/"
}
const { page, totalPages, basePath } = Astro.props;
const first = basePath === "/" ? "/page/1/" : `${basePath}page/1/`;
const last =
  basePath === "/" ? `/page/${totalPages}/` : `${basePath}page/${totalPages}/`;
const prev =
  page > 1
    ? basePath === "/"
      ? `/page/${page - 1}/`
      : `${basePath}page/${page - 1}/`
    : null;
const next =
  page < totalPages
    ? basePath === "/"
      ? `/page/${page + 1}/`
      : `${basePath}page/${page + 1}/`
    : null;
// Zola home page 1 is also /
const prevHref = page === 2 && basePath === "/" ? "/" : prev;

const Prev = prevHref ? "a" : "span";
const Next = next ? "a" : "span";
---

<nav
  class="fa-container mx-auto mt-8 flex flex-row items-center justify-center text-lg *:py-4 text-muted-foreground *:hover:text-foreground *:hover:underline not-md:px-4"
>
  <Prev
    aria-label="Go to first page"
    class:list={["pr-10", !prev && "text-muted-foreground/20!"]}
    href={first}
  >
    <ChevronsLeft class="size-8" aria-hidden="true" />
  </Prev>
  <div class="flex-1"></div>
  <Prev
    class:list={[
            "flex flex-row items-center *:block px-5",
            !prevHref && "text-muted-foreground/20!",
        ]}
    href={prevHref ?? undefined}
  >
    <ChevronLeft class="size-8" aria-hidden="true" />
    <span class="not-md:hidden">上一页</span>
  </Prev>
  <span class="px-5">{page}</span>
  <Next
    class:list={[
            "flex flex-row items-center *:block px-5",
            !next && "text-muted-foreground/20!",
        ]}
    href={next ?? undefined}
  >
    <span class="not-md:hidden">下一页</span>
    <ChevronRight class="size-8" aria-hidden="true" />
  </Next>
  <div class="flex-1"></div>
  <Next
    aria-label="Go to last page"
    class:list={["pl-10", !next && "text-muted-foreground/20!"]}
    href={last}
  >
    <ChevronsRight class="size-8" aria-hidden="true" />
  </Next>
</nav>
