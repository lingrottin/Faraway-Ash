---
import Banner from "../../../components/site/Banner.astro";
import Pagination from "../../../components/taxonomy/Pagination.astro";
import PostList from "../../../components/taxonomy/PostList.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteConfig } from "../../../lib/site";
import { getTaxonomyList, paginate } from "../../../lib/taxonomy";

export async function getStaticPaths() {
  const list = await getTaxonomyList("categories");
  return list.map((item) => ({
    params: { slug: item.slug },
    props: { name: item.name, posts: item.posts },
  }));
}

const { name, posts } = Astro.props;
const { items, page, totalPages } = paginate(posts, 1, siteConfig.pageSize);
const basePath = `/categories/${Astro.params.slug}/`;
---

<style>
.category-name {
  background-image: linear-gradient(
    110deg,
    var(--strong-accent),
    var(--color-cyan-400),
    var(--color-violet-400),
    var(--strong-accent)
  );
  background-position: 0% 50%;
  background-size: 300% 100%;
  background-clip: text;
  -webkit-background-clip: text;
  color: var(--foreground);
  -webkit-text-fill-color: var(--foreground);
  transition:
    color 300ms ease,
    -webkit-text-fill-color 300ms ease;
}

h1:hover .category-name {
  color: transparent;
  -webkit-text-fill-color: transparent;
  animation: category-name-shimmer 2.8s ease-in-out infinite;
}

@keyframes category-name-shimmer {
  0%,
  100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

@media (prefers-reduced-motion: reduce) {
  .category-name:hover {
    /* biome-ignore-start lint/complexity/noImportantStyles: I want to ensure that motion-reduced user will not see animations */
    color: var(--foreground) !important;
    animation: none !important;
    background-position: 50% 50%;
    /* biome-ignore-end lint/complexity/noImportantStyles: I want to ensure that motion-reduced user will not see animations */
  }
}
</style>

<BaseLayout title={name}>
  <Banner />
  <section class="mt-4 fa-container mx-auto flex flex-col not-md:px-4">
    <header
      class="text-2xl my-4 font-bold text-center pb-4 border-border border-b"
    >
      <h1><span class="category-name mr-2">{name}</span>分类</h1>
    </header>
    <PostList posts={items} />
  </section>
  <Pagination page={page} totalPages={totalPages} basePath={basePath} />
</BaseLayout>
